        tarif = 10000
jumlah = int(input("Jumlah kendaraan: "))

for i in range(1, jumlah + 1):
    print(f"\nKendaraan ke-{i}")
    jenis = input("Jenis (motor/mobil/bus): ").lower()
    jam = float(input("Lama parkir (jam): "))

    # Tarif
    if "motor" in jenis:
        tarif = 2000
    elif "mobil" in jenis:
        tarif = 5000
    else:
        tarif = 10000

    # Hitung biaya
    total = tarif * jam
    tambahan = 5000 if jam > 5 else 0
    total += tambahan

    # Struk detail
    print("\n========== STRUK PARKIR ==========")
    print(f"Jenis Kendaraan  : {jenis.upper()}")
    print(f"Lama Parkir      : {jam} jam")
    print(f"Tarif per Jam    : Rp{tarif:,}")
    print(f"Biaya Tambahan   : Rp{tambahan:,}")
    print(f"Total Pembayaran : Rp{total:,.0f}")
    print("==================================")
